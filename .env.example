# Copy to .env and fill in your SiliconFlow API key for the recommended API path.
# SiliconFlow embedding docs: https://api-docs.siliconflow.cn/docs/api/embeddings-post
# Text and knowledge search do not need an API key. Local BAAI/bge-m3 is optional and is not installed by default.
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-32B

# Optional answer-stage reranker. Library callers opt in; the CLI may select it in auto mode.
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional local bge-m3 options. Only used after installing the local optional dependency.
LOCAL_BGE_M3_USE_FP16=false
